#!/usr/bin/env bash

# zprof を使った zsh 起動プロファイリング
# .zshrc を編集せずに関数ごとの実行時間を計測する

set -euo pipefail

# 一時ディレクトリを作成し、終了時に削除
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# zprof でラップした一時 .zshrc を作成
cat > "$tmpdir/.zshrc" <<'EOF'
zmodload zsh/zprof
source "${HOME}/.zshrc"
zprof
EOF

# ZDOTDIR を一時ディレクトリに向けて zsh を起動
ZDOTDIR="$tmpdir" zsh -i -c exit
