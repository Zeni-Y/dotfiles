# fish shell 設定

# グリーティングメッセージを無効化
set -g fish_greeting

#
# Path settings
#
fish_add_path /usr/local/bin /usr/local/sbin $HOME/.local/bin $HOME/.local/bin/common
{{ if eq .system "client" -}}
fish_add_path $HOME/.local/bin/client
{{ else if eq .system "server" -}}
fish_add_path $HOME/.local/bin/server
{{ end -}}

#
# XDG 規格の環境変数
#
set -gx CLAUDE_CONFIG_DIR "$HOME/.config/claude"
set -gx CODEX_HOME "$HOME/.config/codex"
set -gx CLAUDE_MEM_DATA_DIR "$HOME/.config/claude-mem"
set -gx LANG en_US.UTF-8

{{ if eq .system "server" -}}
#
# サーバー用環境変数
#

# CUDA
set -gx CUDA_HOME /usr/local/cuda
set -gx LD_LIBRARY_PATH "$CUDA_HOME/lib64"
fish_add_path $CUDA_HOME/bin

# Hugging Face
set -gx HF_HOME "$HOME/.cache/huggingface"
set -gx HF_DATASETS_CACHE "$HF_HOME/datasets"
set -gx TRANSFORMERS_CACHE "$HF_HOME/hub"
{{ end -}}

#
# コマンド出力キャッシュ用ディレクトリ
# バージョンをキーにキャッシュし、バージョン変更時のみ再生成
#
set -l _cache_dir ~/.cache/fish

#
# mise ランタイムバージョン管理（shims モード）
# activate 方式の代わりに shims PATH を追加することで起動を高速化
# トレードオフ: cd 時の自動バージョン切替なし（mise reshim が必要）
#
if test -x $HOME/.local/bin/mise
    fish_add_path $HOME/.local/share/mise/shims
end

#
# 言語環境
#

# Go（GOROOT をキャッシュ。go バイナリ更新時に自動再生成）
if type -q go
    set -gx GOPATH "$HOME/ghq"
    set -l _cache $_cache_dir/goroot
    if not test -f $_cache; or test (command -s go) -nt $_cache
        mkdir -p $_cache_dir
        go env GOROOT >$_cache
    end
    read -gx GOROOT <$_cache
    fish_add_path $GOPATH/bin
    fish_add_path $HOME/.go/bin
end

# Rust
test -d $HOME/.cargo/bin && fish_add_path $HOME/.cargo/bin

# Bun
set -gx BUN_INSTALL "$HOME/.bun"
test -d $BUN_INSTALL/bin && fish_add_path $BUN_INSTALL/bin

#
# エイリアス
# - abbr: 実行時に展開表示される（短いコマンド向け）
# - alias: 展開せずそのまま実行（展開後が長いコマンド向け）
#
abbr -a cz chezmoi
abbr -a gm 'git checkout (git symbolic-ref refs/remotes/origin/HEAD | sed "s@^refs/remotes/origin/@@")'
alias ls "eza --long --group --header --binary --time-style=long-iso --icons"
alias ll "eza -la --long --group --header --binary --time-style=long-iso --icons"

#
# zoxide ディレクトリジャンプ（キャッシュ）
# バイナリ更新時のみ再生成
#
if type -q zoxide
    set -l _cache $_cache_dir/zoxide_init.fish
    if not test -f $_cache; or test (command -s zoxide) -nt $_cache
        mkdir -p $_cache_dir
        zoxide init fish >$_cache
    end
    source $_cache
end

#
# プライベート設定
#
if test -f $HOME/.workrc.fish
    source $HOME/.workrc.fish
end
